#!/usr/bin/env bash
# gnumon-run — Execution wrapper for Linux PresentMon (games, Steam, Proton, OpenGL, Vulkan)

set -e

while [ $# -gt 0 ]; do
    case "$1" in
        --overlay|--hud)
            export GNUMON_OVERLAY=1
            shift
            ;;
        --gl)
            export GNUMON_GL=1
            shift
            ;;
        --zink)
            export GNUMON_ZINK=1
            export MESA_LOADER_DRIVER_OVERRIDE=zink
            export GNUMON_OVERLAY=1
            shift
            ;;
        -h|--help)
            echo "Usage: gnumon-run [--overlay|--hud] [--gl] [--zink] <command> [args...]"
            echo "Example for Steam (Vulkan/Proton): gnumon-run --overlay %command%"
            echo "Example for OpenGL (Native):       gnumon-run --gl %command%"
            echo "Example for OpenGL via Zink:       gnumon-run --zink %command%"
            echo "Example: gnumon-run vkcube"
            exit 0
            ;;
        %command%)
            shift
            ;;
        *)
            break
            ;;
    esac
done

if [ $# -eq 0 ]; then
    echo "Usage: gnumon-run [--overlay|--hud] [--gl] [--zink] <command> [args...]"
    echo "Example for Steam: gnumon-run --overlay %command%"
    echo "Example: gnumon-run vkcube"
    exit 1
fi

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

# Read user configuration from ~/.config/gnumon/config.ini if present
CONFIG_FILE="${XDG_CONFIG_HOME:-$HOME/.config}/gnumon/config.ini"
if [ -f "$CONFIG_FILE" ]; then
    CFG_OVERLAY=$(grep -iE "^inGameHudEnabled\s*=" "$CONFIG_FILE" 2>/dev/null | head -n1 | cut -d'=' -f2- | tr -d ' \r\t"')
    if [ "$CFG_OVERLAY" = "true" ] || [ "$CFG_OVERLAY" = "1" ]; then
        export GNUMON_OVERLAY="${GNUMON_OVERLAY:-1}"
    fi
    CFG_CORNER=$(grep -iE "^inGameHudCorner\s*=" "$CONFIG_FILE" 2>/dev/null | head -n1 | cut -d'=' -f2- | tr -d ' \r\t"')
    if [ -n "$CFG_CORNER" ]; then
        export GNUMON_CORNER="${GNUMON_CORNER:-$CFG_CORNER}"
    fi
fi

# Clean AppImage environment leaks from LD_LIBRARY_PATH and Qt variables before launching games
if [ -n "$LD_LIBRARY_PATH" ]; then
    CLEANED_LD=""
    IFS=':' read -ra ADDR <<< "$LD_LIBRARY_PATH"
    for i in "${ADDR[@]}"; do
        if [ -n "${APPDIR:-}" ] && [[ "$i" == "$APPDIR"* ]]; then
            continue
        fi
        if [[ "$i" == *".mount_"* ]] || [[ "$i" == *"/build-appimage/AppDir"* ]]; then
            continue
        fi
        CLEANED_LD="${CLEANED_LD:+$CLEANED_LD:}$i"
    done
    export LD_LIBRARY_PATH="$CLEANED_LD"
fi
unset QT_PLUGIN_PATH
unset QT_QPA_PLATFORM

# Pure implicit layer activation (automatically picked up by Vulkan loader)
USER_IMPLICIT_DIR="$HOME/.local/share/vulkan/implicit_layer.d"
USER_LIB_DIR="$HOME/.local/lib/gnumon"

for d in "$USER_IMPLICIT_DIR" "$USER_LIB_DIR"; do
    if [ -d "$d" ]; then
        export VK_LAYER_PATH="$d${VK_LAYER_PATH:+:$VK_LAYER_PATH}"
    fi
done

if [ ! -f "$USER_IMPLICIT_DIR/VkLayer_gnumon.json" ]; then
    echo "[gnumon-run] Note: Vulkan layer is not yet installed in ~/.local/share/vulkan/implicit_layer.d." >&2
    echo "[gnumon-run] Launch gnumon GUI and click 'Install Layers & Setup' or run 'install-layers.sh'." >&2
fi

# OpenGL LD_PRELOAD handling (64-bit and 32-bit multilib):
# Only activate for native OpenGL if explicitly requested via GNUMON_GL=1 or --gl
if [ "${GNUMON_GL:-0}" = "1" ]; then
    LIB_GL=""
    LIB32_GL=""
    for p in "$HOME/.local/lib/gnumon" "/usr/local/lib" "/usr/lib" "$SCRIPT_DIR" "$SCRIPT_DIR/../build-host"; do
        if [ -f "$p/libgnumon_gl.so" ]; then
            LIB_GL="$p/libgnumon_gl.so"
            break
        fi
    done
    for p in "$HOME/.local/lib/gnumon/lib32" "/usr/local/lib32" "/usr/lib32" "$SCRIPT_DIR/lib32" "$SCRIPT_DIR/../build-host/lib32"; do
        if [ -f "$p/libgnumon_gl.so" ]; then
            LIB32_GL="$p/libgnumon_gl.so"
            break
        fi
    done
    PRELOADS=""
    [ -n "$LIB_GL" ] && PRELOADS="$LIB_GL"
    [ -n "$LIB32_GL" ] && PRELOADS="${PRELOADS:+$PRELOADS:}$LIB32_GL"
    if [ -n "$PRELOADS" ]; then
        export LD_PRELOAD="$PRELOADS${LD_PRELOAD:+:$LD_PRELOAD}"
    fi
fi

exec "$@"
