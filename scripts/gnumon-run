#!/usr/bin/env bash
# gnumon-run — Execution wrapper for Linux PresentMon (games, Steam, Proton, OpenGL, Vulkan)

set -e

if [ $# -eq 0 ]; then
    echo "Usage: gnumon-run <command> [args...]"
    echo "Example for Steam: gnumon-run %command%"
    echo "Example: gnumon-run vkcube"
    exit 1
fi

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

# Clean AppImage environment leaks from LD_LIBRARY_PATH and Qt variables before launching games
if [ -n "$LD_LIBRARY_PATH" ]; then
    CLEANED_LD=""
    IFS=':' read -ra ADDR <<< "$LD_LIBRARY_PATH"
    for i in "${ADDR[@]}"; do
        if [ -n "${APPDIR:-}" ] && [[ "$i" == "$APPDIR"* ]]; then
            continue
        fi
        if [[ "$i" == *".mount_"* ]] || [[ "$i" == *"/build-appimage/AppDir"* ]]; then
            continue
        fi
        CLEANED_LD="${CLEANED_LD:+$CLEANED_LD:}$i"
    done
    export LD_LIBRARY_PATH="$CLEANED_LD"
fi
unset QT_PLUGIN_PATH
unset QT_QPA_PLATFORM

# Always activate Vulkan implicit layer
export ENABLE_GNUMON=1
export VK_INSTANCE_LAYERS="VK_LAYER_GNUMON_capture${VK_INSTANCE_LAYERS:+:$VK_INSTANCE_LAYERS}"

# Ensure user Vulkan layer directory is searched
USER_VULKAN_DIR="$HOME/.local/share/vulkan/implicit_layer.d"
if [ -d "$USER_VULKAN_DIR" ]; then
    export VK_LAYER_PATH="$USER_VULKAN_DIR${VK_LAYER_PATH:+:$VK_LAYER_PATH}"
fi

if [ ! -f "$USER_VULKAN_DIR/VkLayer_gnumon.json" ] && [ ! -f "$HOME/.local/share/vulkan/explicit_layer.d/VkLayer_gnumon.json" ]; then
    echo "[gnumon-run] Note: Vulkan layer is not yet installed in ~/.local/share/vulkan." >&2
    echo "[gnumon-run] Launch gnumon GUI and click 'Install Layer' or run 'install-layers.sh'." >&2
fi

# OpenGL LD_PRELOAD handling:
# Only activate for native OpenGL if explicitly requested via GNUMON_GL=1 or --gl
# to avoid breaking Steam 32-bit wrappers or Proton container processes.
if [ "${GNUMON_GL:-0}" = "1" ] || [ "$1" = "--gl" ]; then
    if [ "$1" = "--gl" ]; then
        shift
    fi
    LIB_GL=""
    for p in "$HOME/.local/lib/gnumon" "/usr/local/lib" "/usr/lib" "$SCRIPT_DIR" "$SCRIPT_DIR/../build-host"; do
        if [ -f "$p/libgnumon_gl.so" ]; then
            LIB_GL="$p/libgnumon_gl.so"
            break
        fi
    done
    if [ -n "$LIB_GL" ]; then
        export LD_PRELOAD="$LIB_GL${LD_PRELOAD:+:$LD_PRELOAD}"
    fi
fi

exec "$@"
