# Maintainer: gnumon team <https://github.com/gnumon/gnumon-linux>
pkgname=gnumon-git
pkgver=0.2.0
pkgrel=1
pkgdesc="Intel PresentMon port for Linux - Real-time Frame Timing, Telemetry and Overlay"
arch=('x86_64')
url="https://github.com/ryslavy/gnumon"
license=('GPL-3.0-or-later')
depends=('vulkan-icd-loader' 'glibc' 'gcc-libs' 'qt6-base')
makedepends=('cmake' 'ninja' 'vulkan-headers' 'git')
provides=('gnumon' 'presentmon')
conflicts=('gnumon')

build() {
    cmake -B build -S . \
        -G Ninja \
        -DCMAKE_BUILD_TYPE=Release \
        -DCMAKE_INSTALL_PREFIX=/usr
    ninja -C build
}

package() {
    DESTDIR="${pkgdir}" ninja -C build install
}
